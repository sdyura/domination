MapStore

Installation:

# make sure apache 2 is installed
sudo apt install apache2

# we need to get all the extras for Django
sudo -H pip install Django==1.2.7 --no-cache-dir --no-binary all

# PIP NEEDS TO BE RUN WITH SUDO!!!!! or wont run from apache
sudo -H pip install -r requirments.txt

# django-ratings is in a local folder
sudo pip install django-ratings

# database & storage must have read/write permissions for www-data group
chmod -R ug+rw database storage
chgrp -R www-data database storage

# Link risk.apache2-conf to /etc/apache2/sites-enabled, be sure to set correct paths in this file
sudo ln -s risk.apache2-conf /etc/apache2/sites-enabled/risk.conf

# ./static/admin must point to your django install static admin files, something like:
ln -s /usr/local/lib/python2.7/dist-packages/django/contrib/admin/media static/admin


